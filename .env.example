# TMAP 대중교통 API 앱 키 (SK open API 콘솔에서 발급). 실제 값은 .env.local에 넣는다.
TMAP_APP_KEY=
# 공공데이터포털 서비스 키 (Decoding 키): TAGO 지하철정보, 서울 버스 API 활용 신청
TAGO_SERVICE_KEY=
# 카카오 디벨로퍼스 REST API 키 (카카오맵 사용 설정 필요)
KAKAO_REST_API_KEY=

# 국가철도공단(KRIC) 역사별 운행시각표 서비스 키 (스파이크용)
KRIC_SERVICE_KEY=

# 서울 열린데이터광장 일반 인증키 (1~9호선 시간표)
SEOUL_OPENAPI_KEY=

# 서울 열린데이터광장 실시간 지하철 인증키 (일반 인증키와 별도 신청, 1~9호선 실시간 도착)
SEOUL_SUBWAY_REALTIME_KEY=
